// ========================================================
// GENERATED PARAMETERIZED PRISM MODEL FOR MPSoC DEPLOYMENT
// Grounded in FTS & Product Line Approach
// when evaluating the Pmin and Pmax properties.
// ========================================================

mdp

// --- PARAMETERIZATION CONSTANTS ---
const int num_pes; // Target number of processors (PE)
const int num_nes; // Target number of connectors/buses (NE)

// --- FEATURE SELECTION CONSTANTS ---
const bool platform = true; // root node
const int PE1; // 0 or 1
const int PE2; // 0 or 1
const int PE3; // 0 or 1
const int PE4; // 0 or 1
const int PE5; // 0 or 1
const int PE6; // 0 or 1
const int NE1; // 0 or 1
const int NE2; // 0 or 1
const int NE3; // 0 or 1

// Formula ensuring that the selected constants form a valid FD configuration
formula valid_configuration = platform & (PE1=1 | PE2=1 | PE3=1 | PE4=1 | PE5=1 | PE6=1) & (NE1=1 | NE2=1 | NE3=1);

// --- DYNAMIC RELIABILITY FORMULAS (CALIBRATED TO TABLE 3) ---
formula PE = PE1 + PE2 + PE3 + PE4 + PE5 + PE6;
formula NE = NE1 + NE2 + NE3;

formula p_success_PE1 = 
    (PE = 1) ? 0.860988 : (
    (PE = 2) ? ((PE2 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? ((PE3 = 1) ? 0.953263 : 0.961144) : (
    (PE = 4) ? ((PE4 = 1) ? 0.991969 : 0.993149) : (
    (PE = 5) ? 0.998884 : 0.975511
    ))));

formula p_success_PE2 = 
    (PE = 1) ? 0.860988 : (
    (PE = 2) ? ((PE1 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? ((PE3 = 1) ? 0.953263 : 0.961144) : (
    (PE = 4) ? ((PE4 = 1) ? 0.991969 : 0.993149) : (
    (PE = 5) ? 0.998884 : 0.975511
    ))));

formula p_success_PE3 = 
    (PE = 1) ? 0.864606 : (
    (PE = 2) ? ((PE1 = 1 & PE2 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? 0.953263 : (
    (PE = 4) ? ((PE4 = 1) ? 0.991969 : 0.993149) : (
    (PE = 5) ? 0.998884 : 0.975511
    ))));

formula p_success_PE4 = 
    (PE = 1) ? 0.864606 : (
    (PE = 2) ? ((PE1 = 1 & PE2 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? ((PE3 = 1) ? 0.953263 : 0.961144) : (
    (PE = 4) ? 0.991969 : (
    (PE = 5) ? 0.998884 : 0.976859
    ))));

formula p_success_PE5 = 
    (PE = 1) ? 0.864606 : (
    (PE = 2) ? ((PE1 = 1 & PE2 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? ((PE3 = 1) ? 0.953263 : 0.961144) : (
    (PE = 4) ? ((PE4 = 1) ? 0.991969 : 0.993149) : (
    (PE = 5) ? 0.998884 : 0.976859
    ))));

formula p_success_PE6 = 
    (PE = 1) ? 0.864606 : (
    (PE = 2) ? ((PE1 = 1 & PE2 = 1) ? 0.921685 : 0.925875) : (
    (PE = 3) ? ((PE3 = 1) ? 0.953263 : 0.961144) : (
    (PE = 4) ? ((PE4 = 1) ? 0.991969 : 0.993149) : (
    (PE = 5) ? 0.998884 : 0.976859
    ))));

// --- DEPLOYMENT STATE ENGINE ---
module deployment
    // state variable: 0=init, 1=running, 2=success, 3=failed
    deploy_state : [0..3] init 0;
    step : [0..41] init 0;
    WSR_R_done : bool init false;
    WSR_F_done : bool init false;
    CruiseControl_done : bool init false;
    BrakePedal_done : bool init false;
    EmergencyStop_done : bool init false;
    LoadCompensator_done : bool init false;
    ABS_Main_done : bool init false;
    WAC_F_done : bool init false;
    WAC_R_done : bool init false;

    // Start deployment
    [] deploy_state = 0 & valid_configuration -> (deploy_state' = 1) & (step' = min(step + 1, 41));
    [] deploy_state = 0 & !valid_configuration -> (deploy_state' = 3) & (step' = min(step + 1, 41));

    // Task scheduling & Processor execution mapping
    // Scheduling of WSR_R
    [pe1] deploy_state = 1 & true & !WSR_R_done & PE1 = 1 ->
        p_success_PE1 : (WSR_R_done' = true) & (step' = min(step + 1, 41)) +
        (1.0 - p_success_PE1) : (deploy_state' = 3) & (step' = min(step + 1, 41));
