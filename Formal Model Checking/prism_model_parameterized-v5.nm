    [ne1] deploy_state = 1 & ABS_Main_done & !WAC_F_done & NE1 = 1 ->
        1.0 : (step' = min(step + 1, 41));
    [ne2] deploy_state = 1 & ABS_Main_done & !WAC_F_done & NE2 = 1 ->
        1.0 : (step' = min(step + 1, 41));
    [ne3] deploy_state = 1 & ABS_Main_done & !WAC_F_done & NE3 = 1 ->
        1.0 : (step' = min(step + 1, 41));
    [ne1] deploy_state = 1 & ABS_Main_done & !WAC_R_done & NE1 = 1 ->
        1.0 : (step' = min(step + 1, 41));
    [ne2] deploy_state = 1 & ABS_Main_done & !WAC_R_done & NE2 = 1 ->
        1.0 : (step' = min(step + 1, 41));
    [ne3] deploy_state = 1 & ABS_Main_done & !WAC_R_done & NE3 = 1 ->
        1.0 : (step' = min(step + 1, 41));

    // Success transition when all tasks complete successfully
    [] deploy_state = 1 & WSR_R_done & WSR_F_done & CruiseControl_done & BrakePedal_done & EmergencyStop_done & LoadCompensator_done & ABS_Main_done & WAC_F_done & WAC_R_done -> (deploy_state' = 2) & (step' = min(step + 1, 41));

    // Self-loops for terminal states to prevent deadlocks
    [] deploy_state = 2 -> (deploy_state' = 2);
    [] deploy_state = 3 -> (deploy_state' = 3);
endmodule

// --- LABELS ---
label "success" = deploy_state = 2;
label "failed" = deploy_state = 3;
label "PE" = PE = num_pes;
label "NE" = NE = num_nes;

// --- REWARDS ---
rewards "processors_used"
    [pe1] true : 1;
    [pe2] true : 1;
    [pe3] true : 1;
    [pe4] true : 1;
    [pe5] true : 1;
    [pe6] true : 1;
endrewards

rewards "time"
    [] deploy_state = 1 : 1;
endrewards
